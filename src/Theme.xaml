<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Text" Color="#E6EDF8"/>
  <SolidColorBrush x:Key="Muted" Color="#93A3BB"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#0B101A"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="#DCE5F4"/><Setter Property="Background" Value="#1B293C"/><Setter Property="Padding" Value="17,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderThickness" Value="2"/><Setter TargetName="B" Property="BorderBrush" Value="#53E3C2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Foreground" Value="#122132"/><Setter Property="Background" Value="#DDE7F2"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#122132"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101B2B"/><Setter Property="Foreground" Value="#E6EDF8"/><Setter Property="BorderBrush" Value="#30415C"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="#53E3C2"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE5F4"/><Setter Property="Margin" Value="0,12"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#101824"/><Setter Property="Foreground" Value="#E6EDF8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
</ResourceDictionary>
